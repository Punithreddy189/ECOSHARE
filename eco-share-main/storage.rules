rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images uploaded for resources and user avatars
    match /resources/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
